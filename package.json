{
  "name": "ottertrail",
  "version": "0.2.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "vp run -r --parallel dev",
    "migrate": "vp run -r migrate",
    "geo:update": "vp run -r geo:update",
    "visits": "vp -C apps/api run visits",
    "setup": "vp -C apps/api run setup",
    "reset-password": "vp -C apps/api run reset-password",
    "report": "vp -C apps/api run report",
    "bench:reports": "vp -C apps/api run bench:reports",
    "version": "node scripts/version.ts",
    "ready": "vp check && vp run -r test && vp run -r build",
    "prepare": "vp config --no-agent"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.21.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=26.0.0"
  }
}
