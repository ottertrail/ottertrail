# Copy to .env in this folder and fill in. Keep .env private: it holds the
# database password and the key that signs sign-in cookies.

# The instance's domain, without https://. Point its DNS A (and AAAA) record
# at this server before the first start, so Caddy can get a certificate.
OTTERTRAIL_DOMAIN=analytics.example.com

# Generate each with: openssl rand -hex 32
# (hex only, so the password is safe inside the database URL).
# PostgreSQL keeps the password it was first created with: to change it
# later, see "Settings" in docs/deployment.md.
POSTGRES_PASSWORD=
AUTH_SECRET=

# The timezone of the organization the setup link creates, an IANA name.
# Reports count days in it, and visitor IDs change at its midnight. Each
# organization can change its own later, in its settings.
TIMEZONE=UTC

# Optional: an image from a registry instead of building from this checkout.
# Then update with `docker compose pull`, never `docker compose up --build`.
# OTTERTRAIL_IMAGE=ghcr.io/example/ottertrail:0.1.0
