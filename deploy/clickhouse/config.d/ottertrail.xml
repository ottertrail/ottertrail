<!--
  ClickHouse on a small server it shares with PostgreSQL, the API, and the
  worker, such as 8 GB in all. ClickHouse's defaults assume a machine of its
  own with 16 GB or more; its own guide suggests these changes for less
  (https://clickhouse.com/docs/operations/tips). deploy/compose.yaml holds
  this file inline; the development stack (compose.yaml at the repository
  root) reads the copy in deploy/clickhouse/. A test keeps the two the same.
-->
<clickhouse>
    <!-- At most 40% of the machine's memory. A query that would go over fails
         on its own instead of the kernel killing the whole server. -->
    <max_server_memory_usage_to_ram_ratio>0.4</max_server_memory_usage_to_ram_ratio>

    <!-- 512 MiB instead of 5 GiB: the guide's lowest suggestion. -->
    <mark_cache_size>536870912</mark_cache_size>

    <!-- Internal logs Ottertrail never reads. Each costs memory and disk. -->
    <trace_log remove="1"/>
    <text_log remove="1"/>
    <metric_log remove="1"/>
    <asynchronous_metric_log remove="1"/>
    <query_thread_log remove="1"/>
    <query_views_log remove="1"/>
    <part_log remove="1"/>
    <processors_profile_log remove="1"/>
    <query_metric_log remove="1"/>
    <error_log remove="1"/>
    <background_schedule_pool_log remove="1"/>
    <instrumentation_trace_log remove="1"/>
    <opentelemetry_span_log remove="1"/>
    <iceberg_metadata_log remove="1"/>
    <delta_lake_metadata_log remove="1"/>

    <!-- The logs kept get a time limit: ClickHouse keeps them forever by
         default, on the disk the data shares. query_log has a row for every
         query and insert; tests read it to measure queries, and an operator
         can look up a slow one there. -->
    <query_log>
        <ttl>event_date + INTERVAL 7 DAY DELETE</ttl>
    </query_log>
    <backup_log>
        <ttl>event_date + INTERVAL 30 DAY DELETE</ttl>
    </backup_log>
    <crash_log>
        <ttl>event_date + INTERVAL 30 DAY DELETE</ttl>
    </crash_log>

    <logger>
        <level>warning</level>
    </logger>

    <!-- Where BACKUP ... TO File('name.zip') writes, and RESTORE reads
         (docs/deployment.md, "Backups"). deploy/compose.yaml mounts a volume
         of its own here, which the worker reads for scheduled backups. -->
    <backups>
        <allowed_path>/var/lib/clickhouse/backups/</allowed_path>
    </backups>

    <!-- Refuse inserts while less than 5% of the disk is free, rather than
         fill it: PostgreSQL, Garage, and backups share the disk, and
         PostgreSQL stops when its write-ahead log cannot grow. Collection
         then answers 503 and the tracker retries. A MergeTree setting, here
         the default of every table; the system database is never refused.
         Docs: https://clickhouse.com/docs/operations/settings/merge-tree-settings;
         the check: src/Storages/MergeTree/MergeTreeDataWriter.cpp#L866-L900
         at tag v26.8.38.9-lts. -->
    <merge_tree>
        <min_free_disk_ratio_to_perform_insert>0.05</min_free_disk_ratio_to_perform_insert>
    </merge_tree>
</clickhouse>
