# Copy to .env next to compose.yaml and fill in. Keep .env private: it
# holds the database passwords, the key that signs sign-in cookies, the
# object store's keys, and the SMTP password when there is one.

# The release to run: the tag of the published image
# (ghcr.io/ottertrail/ottertrail). The compose.yaml from a release already
# defaults to that release, so leave this unset to run it. Set it to pin a
# release, or to move to another one without downloading its compose.yaml.
# OTTERTRAIL_VERSION=0.1.0

# The instance's domain, without https://. Point its DNS A (and AAAA) record
# at this server before the first start, so Caddy can get a certificate.
OTTERTRAIL_DOMAIN=analytics.example.com

# Required. Generate each with: openssl rand -hex 32
# (hex only, so the password is safe inside the database URL).
# PostgreSQL keeps the password it was first created with: to change it
# later, see "Settings" in docs/deployment.md.
POSTGRES_PASSWORD=
CLICKHOUSE_PASSWORD=
AUTH_SECRET=

# Session replays and source maps need an S3-compatible object store. By
# default the stack runs its own, Garage, on this server: the object-store
# profile below turns it on. Generate its keys and secret with:
#   OBJECT_STORE_ACCESS_KEY_ID:      printf 'GK%s\n' "$(openssl rand -hex 12)"
#   OBJECT_STORE_SECRET_ACCESS_KEY:  openssl rand -hex 32
#   GARAGE_RPC_SECRET:               openssl rand -hex 32
#   GARAGE_ADMIN_TOKEN:              openssl rand -hex 32
# While one of the first three is empty, migrate or Garage stops at start
# and its log says why (docs/deployment.md, "Missing settings").
# GARAGE_ADMIN_TOKEN is optional: with it, the Settings page's Storage
# section shows the bucket's real size and Garage's disk, and the worker
# keeps a quota on the bucket a little above the budgets below. Without
# it, everything else works (docs/deployment.md, "Storage").
OBJECT_STORE_ACCESS_KEY_ID=
OBJECT_STORE_SECRET_ACCESS_KEY=
GARAGE_RPC_SECRET=
GARAGE_ADMIN_TOKEN=
COMPOSE_PROFILES=object-store
OBJECT_STORE_URL=http://garage:3900
#
# Cloudflare R2, Amazon S3, or another S3-compatible store instead: remove
# the COMPOSE_PROFILES line, set OBJECT_STORE_URL to the store's endpoint
# (for R2, https://<account ID>.r2.cloudflarestorage.com), uncomment and
# set its region (auto for R2) and bucket, and put the bucket's keys above.
# GARAGE_RPC_SECRET and GARAGE_ADMIN_TOKEN can stay empty.
# OBJECT_STORE_REGION=garage
# OBJECT_STORE_BUCKET=ottertrail
#
# No object store: remove the COMPOSE_PROFILES and OBJECT_STORE_URL lines.
# Session replays and source maps are then off; everything else works.
#
# Compressed source maps the instance may keep, all projects together, in
# bytes (default 1 GiB).
# SOURCE_MAP_STORAGE_BYTES=1073741824
# Compressed session replays the instance may keep, all projects together,
# in bytes (default 2 GiB).
# REPLAY_STORAGE_BYTES=2147483648
# backup.sh backs up the store too (docs/deployment.md, "Backups").

# Optional: events the instance may store per second, all projects
# together (bursts of ten seconds' worth). Each project also has its own
# budget inside it, so one project cannot crowd out the others.
# INSTANCE_EVENTS_PER_SECOND=600

# Optional: days ClickHouse keeps traces, logs, and metrics sent over OTLP,
# from 1 to 365 (default 30). After a change, run `docker compose up -d`.
# TELEMETRY_RETENTION_DAYS=30

# Optional: alert email only, sent through an SMTP server
# (docs/deployment.md, "Alert email"). Invitations and password reset links
# never need it: they are links you pass on yourself. Without it, email
# channels can be made, but nothing is sent to them; webhooks work either
# way. The user name and password go in the URL, percent-encoded: smtps://
# for TLS from the start (port 465), or smtp:// with STARTTLS (port 587),
# which is then required.
# SMTP_URL=smtps://user:password@smtp.example.com:465
# EMAIL_FROM=Ottertrail <alerts@example.com>
