{
  "name": "ottertrail",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp run -r --parallel dev",
    "migrate": "vp run -r migrate",
    "geo:update": "vp run -r geo:update",
    "ready": "vp check && vp run -r test && vp run -r build",
    "prepare": "vp config --no-agent"
  },
  "devDependencies": {
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.21.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=26.0.0"
  }
}
