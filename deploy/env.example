# Copy to .env in this folder and fill in. Keep .env private: it holds the
# database password and the key that signs sign-in cookies.

# The instance's domain, without https://. Point its DNS A (and AAAA) record
# at this server before the first start, so Caddy can get a certificate.
OTTERTRAIL_DOMAIN=analytics.example.com

# Generate each with: openssl rand -hex 32
# (hex only, so the password is safe inside the database URL).
# PostgreSQL keeps the password it was first created with: to change it
# later, see "Settings" in docs/deployment.md.
POSTGRES_PASSWORD=
CLICKHOUSE_PASSWORD=
AUTH_SECRET=

# The instance's timezone, an IANA name, which the setup link sets.
# Reports count days in it, and visitor IDs change at its midnight. The
# owner can change it later, on the dashboard's Settings page.
TIMEZONE=UTC

# Optional: events the instance may store per second, all projects
# together (bursts of ten seconds' worth). Each project also has its own
# budget inside it, so one project cannot crowd out the others.
# INSTANCE_EVENTS_PER_SECOND=600

# Optional: source maps, which turn minified stack traces back into your
# code (docs/errors.md). They need an S3-compatible object store. To run
# Garage on this server, start the stack with --profile object-store and set:
#   OBJECT_STORE_URL=http://garage:3900
#   OBJECT_STORE_ACCESS_KEY_ID=   printf 'GK%s\n' "$(openssl rand -hex 12)"
#   OBJECT_STORE_SECRET_ACCESS_KEY=   openssl rand -hex 32
#   GARAGE_RPC_SECRET=   openssl rand -hex 32
# For Cloudflare R2 or Amazon S3 instead, set OBJECT_STORE_URL to its
# endpoint, OBJECT_STORE_REGION (auto for R2), OBJECT_STORE_BUCKET, and its
# access keys, and leave the profile off.
# OBJECT_STORE_URL=
# OBJECT_STORE_ACCESS_KEY_ID=
# OBJECT_STORE_SECRET_ACCESS_KEY=
# GARAGE_RPC_SECRET=
# OBJECT_STORE_REGION=garage
# OBJECT_STORE_BUCKET=ottertrail
# Compressed source maps the instance may keep, all projects together, in
# bytes (default 1 GiB).
# SOURCE_MAP_STORAGE_BYTES=1073741824
# Session replays around errors use the same store (docs/session-replay.md).
# Compressed replays the instance may keep, all projects together, in
# bytes (default 2 GiB).
# REPLAY_STORAGE_BYTES=2147483648

# Optional: days ClickHouse keeps traces, logs, and metrics sent over OTLP,
# from 1 to 365 (default 30). After a change, run `docker compose up -d`.
# TELEMETRY_RETENTION_DAYS=30

# Optional: an image from a registry instead of building from this checkout.
# Then update with `docker compose pull`, never `docker compose up --build`.
# OTTERTRAIL_IMAGE=ghcr.io/example/ottertrail:0.1.0
